[Unit]
Description=Monutchee Provisioning Station
After=network-online.target mnc-station-hw-server.service
Wants=network-online.target mnc-station-hw-server.service

[Service]
Type=simple
User=mnc-station
Group=mnc-station
EnvironmentFile=-/etc/default/mnc-station
WorkingDirectory=/var/lib/mnc-station
ExecStart=/usr/bin/mnc-station serve --tftp-listen=:69 --data-dir=/var/lib/mnc-station
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/mnc-station
UMask=0077

[Install]
WantedBy=multi-user.target
