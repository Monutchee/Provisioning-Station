# Optional Provisioning Station environment.
# The service automatically searches /opt/Xilinx after checking PATH.
# Set this only for a nonstandard install or explicit version selection.
# MPS_XSDB=/opt/Xilinx/Vitis/2025.2/bin/xsdb

# The companion service automatically finds hw_server and binds it to loopback
# so only software on this Station can control JTAG. Override either setting
# for a nonstandard installation or an intentionally LAN-accessible server.
# MPS_HW_SERVER=/opt/Xilinx/2025.2/HWSRVR/bin/hw_server
# MPS_HW_SERVER_LISTEN=tcp:127.0.0.1:3121

# The packaged service listens on every IPv4 interface by default. Override it
# with the following setting when the dashboard must be local-only.
# MPS_HTTP_LISTEN=127.0.0.1:8042

# A non-loopback listener automatically creates
# /var/lib/mps/api-token. Set this to use a managed token instead.
# MPS_TOKEN_FILE=/etc/mps/token

# FT2232H channel B defaults to 115200 8N1. Job transcripts retain 16 MiB.
# MPS_SERIAL_BAUD=115200
# MPS_MAX_CONSOLE_LOG_BYTES=16777216
