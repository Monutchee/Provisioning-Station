_mps() {
    local current="${COMP_WORDS[COMP_CWORD]}"
    if ((COMP_CWORD == 1)); then
        COMPREPLY=( $(compgen -W 'status target artifact job serial tui service mcp version help' -- "$current") )
    else
        COMPREPLY=()
    fi
}
complete -F _mps mps
